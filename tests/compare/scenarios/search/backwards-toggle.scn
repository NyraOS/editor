# M-B in the prompt searches backwards for that search only; M-B again turns it off.
args: text.txt
file text.txt:
| the cat sat
| on the mat
| with the hat
keys: {^W}
keys: {M-b}
keys: at{Enter}
keys: {^C}
keys: {^W}
keys: {M-b}
keys: {M-b}
keys: {^C}
keys: {^Q}
keys: {M-b}
keys: {Enter}
keys: {^C}
keys: {^X}
