# Moving down past the bottom row scrolls one line; moving up past the top scrolls back.
args: long.txt
size: 40x10
file long.txt:
| line 1
| line 2
| line 3
| line 4
| line 5
| line 6
| line 7
| line 8
| line 9
| line 10
| line 11
| line 12
keys: {Down*5}
keys: {Down}
keys: {Down*3}
keys: {Up*5}
keys: {Up*4}
keys: {^X}
