# syntax, header, magic, color, icolor and extendsyntax are read; magic is ignored.
nanorc: syntax "sh" "\\.sh$"
nanorc: header "^#!.*/sh"
nanorc: magic "shell script"
nanorc: color red "\\<if\\>"
nanorc: icolor brightblue "TODO"
nanorc: color green start="a" end="b"
nanorc: extendsyntax sh color red "x"
nanorc: set linenumbers
args: a.txt
file a.txt:
| if x
keys: {^X}
