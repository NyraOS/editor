# A click puts the cursor on the character under it: in a tab, on a wide character, past the end
# of a line, and not in the line numbers or below the text. The release decides the place.
args: --mouse --linenumbers t.txt
size: 40x12
file t.txt:
| first line here
| \tsecond line
| third
| 日本語 wide chars and a rather long line that goes past the end of the window for sure
| 
keys: {Click 10 3}
keys: {Mouse 0 10 2 M}
keys: {Mouse 0 14 3 m}
keys: {Click 5 3}
keys: {Click 9 5}
keys: {Click 20 5}
keys: {Click 20 6}
keys: {Click 20 7}
keys: {Click 1 4}
keys: {Click 4 4}
keys: {Click 20 2}
keys: {Click 20 9}
keys: {Click 20 1}
keys: {Click 20 10}
keys: {Click 5 2}
