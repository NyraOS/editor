# Combining marks stay with their letter at the edge.
args: -S x.txt
size: 20x12
file x.txt:
| e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81e\xcc\x81
| abcdefghijklmnopqrs\xcc\x81tuv
keys: {End}
keys: {Down}
keys: {End}
keys: {^X}
