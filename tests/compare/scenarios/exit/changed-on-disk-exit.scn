# The file changes on disk; ^X and Yes warn, then ask; ^C goes back to the file name, and the
# file stays as it is on disk.
args: c.txt
file c.txt:
| original
keys: x
# GNU nano compares the times of change in whole seconds.
pause: 1100
file c.txt:
| changed elsewhere
| and longer
keys: {^X}
keys: y
keys: {Enter}
pause: 2000
keys: {^C}
keys: {^C}
keys: {^X}
keys: n
