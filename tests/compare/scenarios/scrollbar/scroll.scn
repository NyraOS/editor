# The scroll bar: its thumb follows the top line while paging, going to the end, and the wheel;
# a long line stops before it.
args: --indicator t.txt
size: 40x12
file t.txt:
| a first line that is longer than the width of the screen minus the bar, to be cut
| line 1
| line 2
| line 3
| line 4
| line 5
| line 6
| line 7
| line 8
| line 9
| line 10
| line 11
| line 12
| line 13
| line 14
| line 15
| line 16
| line 17
| line 18
| line 19
| line 20
| line 21
| line 22
| line 23
| line 24
| line 25
| line 26
| line 27
| line 28
| line 29
| line 30
| line 31
| line 32
| line 33
| line 34
| line 35
| line 36
| line 37
| line 38
| line 39
| line 40
keys: {PgDn}
keys: {PgDn*2}
keys: {M-/}
keys: {Up*3}
keys: {M-\}
keys: {Down*8}
