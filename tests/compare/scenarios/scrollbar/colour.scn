# scrollercolor: the track has the colour, the thumb has it inverse. The lines fill the text
# width, so that nano draws the track cells itself: a blank cell at the end of a short line is
# drawn by ncurses as a delete-character, which the test terminal shows without the colour.
nanorc: set indicator
nanorc: set scrollercolor white,blue
size: 30x12
args: t.txt
file t.txt:
| line 01 -----------------
| line 02 -----------------
| line 03 -----------------
| line 04 -----------------
| line 05 -----------------
| line 06 -----------------
| line 07 -----------------
| line 08 -----------------
| line 09 -----------------
| line 10 -----------------
| line 11 -----------------
| line 12 -----------------
| line 13 -----------------
| line 14 -----------------
| line 15 -----------------
| line 16 -----------------
| line 17 -----------------
| line 18 -----------------
| line 19 -----------------
| line 20 -----------------
| line 21 -----------------
| line 22 -----------------
| line 23 -----------------
| line 24 -----------------
| line 25 -----------------
| line 26 -----------------
| line 27 -----------------
| line 28 -----------------
| line 29 -----------------
| line 30 -----------------
| line 31 -----------------
| line 32 -----------------
| line 33 -----------------
| line 34 -----------------
| line 35 -----------------
| line 36 -----------------
| line 37 -----------------
| line 38 -----------------
| line 39 -----------------
| line 40 -----------------
keys: {PgDn}
keys: {M-/}
