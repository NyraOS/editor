# SPDX-License-Identifier: MIT
# A small example syntax for shell scripts, in the nanorc format. Put it in a file of your own and
# name that file in an `include` line of ~/.nanorc (README: "Syntax colouring"). It is also read
# by a test, so it stays correct.
#
# A later `color` line paints over an earlier one, so the general rules come first.

syntax sh "\.sh$"
header "^#!.*/(env +)?(ba|da|a)?sh( |$)"
comment "#"

color green "\<(if|then|elif|else|fi|for|while|until|do|done|case|esac|in|function)\>"
color brightgreen "[][(){}|&;<>=]"
color cyan "\$[A-Za-z_][A-Za-z0-9_]*|\$\{[^}]*\}|\$[0-9#?@*!$-]"
color yellow ""([^"\]|\\.)*""
color yellow "'[^']*'"
color brightblue start="<<-?'?EOF'?" end="^EOF$"
color brightblue "(^|[[:space:]])#.*$"
